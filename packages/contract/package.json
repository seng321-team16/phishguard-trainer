{
  "name": "@phishguard/contract",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript types generated from api/openapi.yaml (types only, no runtime code)",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml -o src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
