{
  "name": "@phishguard/api",
  "version": "0.2.0",
  "private": true,
  "description": "PhishGuard Trainer REST API (Express 4)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@phishguard/contract": "^0.2.0",
    "express": "^4.22.3",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
