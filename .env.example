# Copy to .env and fill in. Never commit .env.

# Database container (docker compose service "db").
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phishguard

# API. User, password and database name must match the three POSTGRES_ values above.
# The host "db" is the Compose service name; use localhost when the API runs outside Docker.
DATABASE_URL=postgres://phishguard:change-me@db:5432/phishguard
JWT_SECRET=change-me-to-a-long-random-value
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Integration tests: disposable database started with
#   docker compose --profile test up -d db-test
# Fixed throw-away credentials, reachable only from this machine on port 5433.
TEST_DATABASE_URL=postgres://phishguard_test:phishguard_test@localhost:5433/phishguard_test
